# PFC Ticketing System - Environment Variables
# Copy this file to .env.local and fill in your actual values

# Frontend API URL (leave as-is for local development)
VITE_API_URL=/api

# GoHighLevel Configuration
# Get these from your GoHighLevel Private Integration

# Access Token - Find in: Settings > Private Integrations > [Your Integration] > Access Token
# Format: pit-xxxx-xxxx-xxxx-xxxx
GHL_ACCESS_TOKEN=your_access_token_here

# Location ID - Find in: Settings > Business Profile or in the URL when viewing your location
GHL_LOCATION_ID=your_location_id_here

# API URL (keep this as-is)
GHL_API_URL=https://services.leadconnectorhq.com
