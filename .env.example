# PFC Ticketing System - Environment Variables
# Copy this file to .env.local and fill in your actual values

# Frontend API URL (leave as-is for local development)
VITE_API_URL=/api

# GoHighLevel Configuration
# Get these from your GoHighLevel account settings
GHL_CLIENT_ID=your_client_id_here
GHL_CLIENT_SECRET=your_client_secret_here
GHL_LOCATION_ID=your_location_id_here
GHL_API_URL=https://services.leadconnectorhq.com

# Pipeline Configuration (update these with your actual pipeline IDs)
# Find these in GoHighLevel under Settings > Pipelines
GHL_PIPELINE_ID=job-request-management
GHL_STAGE_NEW_REQUEST=new-request
GHL_STAGE_UNDER_REVIEW=under-review
GHL_STAGE_IN_PROGRESS=in-progress
GHL_STAGE_COMPLETED=completed
